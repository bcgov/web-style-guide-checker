{
  "manifest_version": 3,
  "name": "B.C. Web Style Guide Checker",
  "version": "1.3.2",
  "description": "Reviews web content against the B.C. Web Style Guide in a focused, accessible review workflow.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/bcgov/web-style-guide-checker/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open B.C. Web Style Guide Checker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
